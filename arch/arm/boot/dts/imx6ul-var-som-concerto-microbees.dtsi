// Enable USB1 (OTG1) - abilitazione porta USB1
&usbotg1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_otg1_id>;
	dr_mode = "otg";  // Può essere "otg", "host", o "peripheral"
	disable-over-current;
	srp-disable;
	hnp-disable;
	adp-disable;
	status = "okay";  // Esplicitamente abilitata
};

// Disable components you don't need
&snvs_pwrkey {
	status = "disabled";
};

&snvs_rtc {
	status = "disabled";
};

&tsc {
	status = "disabled";
};
